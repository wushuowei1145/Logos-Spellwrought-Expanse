{
  "multipart": [
    { "when": { "north": "true" }, "apply": { "model": "logos_dimension:block/corruption_vein" } },
    { "when": { "down": "false", "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" }, "apply": { "model": "logos_dimension:block/corruption_vein" } },
    { "when": { "east": "true" }, "apply": { "model": "logos_dimension:block/corruption_vein", "y": 90, "uvlock": true } },
    { "when": { "down": "false", "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" }, "apply": { "model": "logos_dimension:block/corruption_vein", "y": 90, "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "logos_dimension:block/corruption_vein", "y": 180, "uvlock": true } },
    { "when": { "down": "false", "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" }, "apply": { "model": "logos_dimension:block/corruption_vein", "y": 180, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "logos_dimension:block/corruption_vein", "y": 270, "uvlock": true } },
    { "when": { "down": "false", "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" }, "apply": { "model": "logos_dimension:block/corruption_vein", "y": 270, "uvlock": true } },
    { "when": { "up": "true" }, "apply": { "model": "logos_dimension:block/corruption_vein", "x": 270, "uvlock": true } },
    { "when": { "down": "false", "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" }, "apply": { "model": "logos_dimension:block/corruption_vein", "x": 270, "uvlock": true } },
    { "when": { "down": "true" }, "apply": { "model": "logos_dimension:block/corruption_vein", "x": 90, "uvlock": true } },
    { "when": { "down": "false", "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" }, "apply": { "model": "logos_dimension:block/corruption_vein", "x": 90, "uvlock": true } }
  ]
}
